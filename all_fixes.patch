From 33bc288f5758de4ed4efb83fa2447bab43e0d2b7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 13 Nov 2025 13:22:37 +0000
Subject: [PATCH 1/3] Fix late fusion to use concatenation instead of averaging

Critical bug fix: Changed from averaging enhanced features to
concatenating them, preserving full 128-dim information instead of
reducing to 64-dim. This should significantly improve performance.

Before: h = (enhanced_graph + enhanced_text) / 2.0  # 64-dim, info loss
After:  h = torch.cat([enhanced_graph, enhanced_text], dim=1)  # 128-dim

Also fixed fc1 layer dimensions to match (128 -> 64).
---
 crysmmnet-main/src/models/alignn.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/crysmmnet-main/src/models/alignn.py b/crysmmnet-main/src/models/alignn.py
index ce9f03f..837a794 100644
--- a/crysmmnet-main/src/models/alignn.py
+++ b/crysmmnet-main/src/models/alignn.py
@@ -517,8 +517,8 @@ class ALIGNN(nn.Module):
                 num_heads=config.cross_modal_num_heads,
                 dropout=config.cross_modal_dropout
             )
-            # Fusion layer after cross-modal attention
-            self.fc1 = nn.Linear(64, 64)  # Single modality after fusion
+            # Fusion layer after cross-modal attention (concatenate both modalities)
+            self.fc1 = nn.Linear(128, 64)  # Concatenated: 64 + 64 = 128
             self.fc = nn.Linear(64, config.output_features)
         else:
             # Original simple concatenation
@@ -600,8 +600,8 @@ class ALIGNN(nn.Module):
         if self.use_cross_modal_attention:
             # Cross-modal attention fusion
             enhanced_graph, enhanced_text = self.cross_modal_attention(h, text_emb)
-            # Average the enhanced features
-            h = (enhanced_graph + enhanced_text) / 2.0
+            # Concatenate enhanced features (preserve full information)
+            h = torch.cat([enhanced_graph, enhanced_text], dim=1)  # [batch, 128]
             h = F.relu(self.fc1(h))
             out = self.fc(h)
         else:
